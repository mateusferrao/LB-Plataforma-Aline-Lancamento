# Variáveis públicas de produção (inlinadas no build estático — aparecem no browser).
# IDs de Pixel/GA4 são públicos por natureza; podem ser versionados.
# O Access Token da CAPI é SEGREDO e vai no painel do Ticto, NUNCA aqui.

NEXT_PUBLIC_META_PIXEL_ID=2630327520757105

# Preencher quando a propriedade GA4 for criada (Measurement ID G-XXXXXXX):
# NEXT_PUBLIC_GA4_ID=

# URL real do checkout Ticto (enquanto vazio, o CTA usa o placeholder #checkout-pendente):
# NEXT_PUBLIC_TICTO_CHECKOUT_URL=
